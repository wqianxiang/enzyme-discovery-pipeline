def check_blast_database(input_database):
    #检查用户指定的 BLAST 数据库是否存在
    if input_database:
        required_files = [
            f"{input_database}.pin",
            f"{input_database}.psq",
            f"{input_database}.phr"
        ]

        # 数据库存在
        if all(os.path.exists(file) for file in required_files):
            print(f"BLAST+ database '{input_database}' is ready.")
            return input_database

        # 数据库不存在
        else:
            print(f"Can not find database '{input_database}'.")
            print("Start building or downloading database...")
            return download_blast_database(input_database)

    # 用户没有提供数据库
    else:
        print("No BLAST database was provided.")
        return download_blast_database(blast_database)

def download_blast_database(input_database):
    #下载建库所需的数据库
    user_input = input("1: Do you want to download and build the BLAST+ database or 2: you have your own database? (1/2):").strip().lower()
    if user_input == '1':
        choice = input(
        """
        Please select the database to download?
        1: nr (non-redundant protein sequences) (recommended for general use)
        2: swissprot (manually annotated and reviewed protein sequences) (recommended for high-quality annotations)
        3: uniprot_trembl (automatically annotated and unreviewed protein sequences) (recommended for comprehensive annotations)
        4: uniprot-swiss-prot (manually annotated and reviewed protein sequences from UniProt) (recommended for high-quality annotations)
        """.strip())

        if choice == '1':
            blast_database_url = "https://ftp.ncbi.nlm.nih.gov/blast/db/FASTA/nr.gz"
            blast_database = "nr"
        elif choice == '2':
            blast_database_url = "https://ftp.ncbi.nlm.nih.gov/blast/db/FASTA/swissprot.gz"
            blast_database = "swissprot"
        elif choice == '3':
            blast_database_url = "https://ftp.uniprot.org/pub/databases/uniprot/knowledgebase/complete/uniprot_trembl.fasta.gz"
            blast_database = "uniprot_trembl"
        elif choice == '4':
            blast_database_url = "https://ftp.uniprot.org/pub/databases/uniprot/knowledgebase/complete/uniprot_sprot.fasta.gz"
            blast_database = "uniprot_sprot"
        else:
            print("Invalid input.")
            sys.exit(1)

        # 下载数据库文件
        subprocess.run(['wget', blast_database_url, '-O', f'{blast_database}.gz'], check=True)
        subprocess.run(['gunzip', f'{blast_database}.gz'], check=True)
        subprocess.run(['makeblastdb', '-in', f'{blast_database}', '-dbtype', 'prot', '-out', f'{blast_database}', '-parse_seqids'], check=True)
        print("BLAST+ database has been downloaded and built.")
        return blast_database

    elif user_input == '2':
        print("Please drag your own database in FASTA format into the current directory and rename it as 'custom.fasta', then run this script again.")
        for _ in tqdm.tqdm(range(300), desc="Waiting for you to prepare your own database...", leave=True):
            time.sleep(1)
            if os.path.exists('custom.fasta'):
                blast_database = "custom"
                subprocess.run(['makeblastdb', '-in', f'{blast_database}.fasta', '-dbtype', 'prot', '-out', f'{blast_database}', '-parse_seqids'], check=True)
                print("BLAST+ database has been downloaded and built.")
                return blast_database
        print("Time's up. Please prepare your own database and run this script again.")
        sys.exit(1)
    else:
        print("Invalid input.")
        sys.exit(1)

def run_blast(query, blast_database, output_file, threshold, length_threshold, max_target_seqs, evalue, outfmt):
    blast_cmd = ["blastp", 
                "-query", query, 
                "-max_target_seqs", str(max_target_seqs), 
                "-db", blast_database, 
                "-out", output_file, 
                "-outfmt", outfmt, 
                "-evalue", str(evalue), 
                "-num_threads", str(os.cpu_count())]
    try:
        subprocess.run(blast_cmd, check=True)
        return True
    except subprocess.CalledProcessError as e:
        print(f"Error running BLAST: {e}")
        sys.exit(1)

def process_blast_results(output_file, threshold, length_threshold, blast_database, processed_result):
    blast_columns = [
        'qseqid', 'sseqid', 'pident', 'length', 'mismatch', 'gapopen',
        'qstart', 'qend', 'sstart', 'send', 'evalue', 'bitscore', 'stitle'
    ]
    threshold_percent = threshold * 100 if threshold <= 1 else threshold
    sequence_output = processed_result + ".fasta"
    seen_sseqids = set()
    filtered_lines = []
    filtered_sseqids = []

    #筛选相似度小于等于阈值，序列长度大于等于长度阈值的结果
    with open(output_file, 'r') as f:
        lines = f.readlines()

    # 1. 保存过滤后的 BLAST 表格结果，给后续 pd.read_csv 和画图使用
    with open(processed_result, 'w') as f:
        f.write('\t'.join(blast_columns) + '\n')
        for line in lines:
            columns = line.strip().split('\t')
            if len(columns) < 4:
                continue
            sseqid = columns[1]
            identity = float(columns[2])
            alignment_length = int(columns[3])
            if identity <= threshold_percent and alignment_length >= length_threshold and sseqid not in seen_sseqids:
                f.write(line)
                filtered_lines.append(line)
                seen_sseqids.add(sseqid)
                filtered_sseqids.append(sseqid.split("||")[1] if "||" in sseqid else sseqid)

    # 2. 使用 blastdbcmd 从最终使用的数据库中提取过滤命中的完整 subject 序列
    with open(sequence_output, 'w') as f:
        for sseqid in filtered_sseqids:
            try:
                subject_sequence = subprocess.run(
                    ['blastdbcmd', '-db', blast_database, '-entry', sseqid, '-outfmt', '%f'],
                    check=True,
                    text=True,
                    capture_output=True
                )
                f.write(subject_sequence.stdout)
            except subprocess.CalledProcessError as e:
                print(f"Warning: failed to extract sequence '{sseqid}' from database '{blast_database}': {e}")

    print(f"Number of filtered sequences: {len(filtered_lines)}")
    print(f"Number of unfiltered sequences: {len(lines) - len(filtered_lines)}")
    print(f"Finished processing BLAST results.")
    print(f"Filtered BLAST table saved to: {processed_result}")
    print(f"Filtered subject sequences saved to: {sequence_output}")
    return filtered_lines

def plot_blast_results(output_file, out_prefix="blast_results_distribution"):
    try:
        def extract_protein(stitle):
            if pd.isna(stitle):
                return "Unknown"
            match = re.search(r"Full=([^;]+)", str(stitle))
            return match.group(1).strip() if match else "Unknown"

        def extract_species(stitle):
            if pd.isna(stitle):
                return "Unknown"
            match = re.search(r"\[([^\]]+)\]", str(stitle))
            return match.group(1).strip() if match else "Unknown"

        df = pd.read_csv(output_file, sep="\t")

        if df.empty:
            print("No filtered BLAST results found. Skip plotting.")
            return

        if "stitle" not in df.columns:
            raise ValueError("Input file must contain a 'stitle' column.")

        df["protein_name"] = df["stitle"].apply(extract_protein)
        df["species"] = df["stitle"].apply(extract_species)

        protein_counts = df["protein_name"].value_counts().head(20).sort_values()
        species_counts = df["species"].value_counts().head(20).sort_values()

        # Nature-like restrained palette
        palette = {
            "protein": "#4C78A8",
            "species": "#72B7B2",
            "text": "#222222",
            "grid": "#D9D9D9",
            "axis": "#333333",
        }

        plt.rcParams.update({
            "font.family": "sans-serif",
            "font.size": 8,
            "axes.titlesize": 10,
            "axes.labelsize": 9,
            "xtick.labelsize": 8,
            "ytick.labelsize": 8,
            "axes.linewidth": 0.8,
            "pdf.fonttype": 42,
            "ps.fonttype": 42,
        })

        fig, axes = plt.subplots(1, 2, figsize=(7.2, 3.6), dpi=300)

        def draw_barh(ax, counts, title, color):
            labels = [textwrap.fill(x, width=34) for x in counts.index]
            bars = ax.barh(labels, counts.values, color=color, edgecolor="none")

            ax.set_title(title, loc="left", fontweight="bold", color=palette["text"])
            ax.set_xlabel("Number of hits")
            ax.grid(axis="x", color=palette["grid"], linewidth=0.6)
            ax.set_axisbelow(True)

            ax.spines["top"].set_visible(False)
            ax.spines["right"].set_visible(False)
            ax.spines["left"].set_color(palette["axis"])
            ax.spines["bottom"].set_color(palette["axis"])
            ax.tick_params(axis="both", colors=palette["text"], length=3)

            max_value = counts.max() if len(counts) else 0
            ax.set_xlim(0, max_value * 1.15 if max_value else 1)

            for bar in bars:
                width = bar.get_width()
                ax.text(
                    width + max_value * 0.02,
                    bar.get_y() + bar.get_height() / 2,
                    f"{int(width)}",
                    va="center",
                    ha="left",
                    fontsize=8,
                    color=palette["text"],
                )

        draw_barh(
            axes[0],
            protein_counts,
            "a  Top 20 protein names",
            palette["protein"],
        )

        draw_barh(
            axes[1],
            species_counts,
            "b  Top 20 species",
            palette["species"],
        )

        fig.tight_layout(w_pad=2.5)

        out_prefix = Path(out_prefix)
        fig.savefig(f"{out_prefix}.png", dpi=600, bbox_inches="tight")
        fig.savefig(f"{out_prefix}.pdf", bbox_inches="tight")
        plt.close(fig)

        print(f"BLAST results distribution plot saved as '{out_prefix}.png' and '{out_prefix}.pdf'.")

    except Exception as e:
        print(f"Error plotting BLAST results: {e}")
        sys.exit(1)

def main():
    global system
    parser = argparse.ArgumentParser(description="BLAST+ pipeline for protein sequence analysis.")
    parser.add_argument('--query', required=True, help="Path to the query FASTA file.")
    parser.add_argument('--blast_database', required=True, help="Path to the BLAST database file.")
    parser.add_argument('--output_file', required=True, help="Path to save the BLAST results.")
    parser.add_argument('--threshold', type=float, default=0.9, help="Threshold for filtering BLAST results (default: 0.9).")
    parser.add_argument('--length_threshold', type=int, default=150, help="Minimum alignment length for reporting matches (default: 150).")
    parser.add_argument('--max_target_seqs', type=int, default=100000000, help="Maximum number of target sequences to report (default: 100000000).")
    parser.add_argument('--evalue', type=float, default=1e-5, help="E-value threshold for reporting matches (default: 1e-5).")
    parser.add_argument('--outfmt', type=str, default="6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle", help="Output format for BLAST results.")
    args = parser.parse_args()

    user_input = input("Do you want to start the sequence blast module of EnzyQXminer (yes/no): ").strip().lower()
    print("--------------------------------------------------------------------")
    if user_input == 'yes':
        print("step1🚀: Checking your system... ")
        time.sleep(1)
        system = check_system()
        print("step2🚀: Checking required software...")
        time.sleep(1)
        check_software_installation()
        print("step3🚀: Checking BLAST+ installation...")
        time.sleep(1)
        check_blast_installation()
        print("step4🚀: Checking BLAST+ database...")
        time.sleep(1)
        blast_database = check_blast_database(args.blast_database)
        print("step5🚀: Running BLAST...")
        time.sleep(1)
        run_blast(
            args.query,
            blast_database,
            args.output_file,
            args.threshold,
            args.length_threshold,
            args.max_target_seqs,
            args.evalue,
            args.outfmt
        )
        print("step6🚀: Processing BLAST results...")
        time.sleep(1)
        processed_result = args.output_file + ".filtered.txt"
