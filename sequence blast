def check_system():
    #检查用户系统(mac,windows,linux)
    print("Checking your system..., please wait...")
    if sys.platform.startswith('linux'):
        print("Your system is Linux.")
        system = 'linux'
    elif sys.platform.startswith('darwin'):
        print("Your system is MacOS.")
        system = 'MacOS'
    elif sys.platform.startswith('win'):
        print("Your system is Windows.")
        system = 'Windows'
    else:
        print("Unsupported system.")
        sys.exit(1)
    return system

def add_file_to_path(file_path):
    #获取文件中需要添加到路径中的文件
    if system == 'linux' or system == 'MacOS':
        shell = os.environ.get('SHELL', '')
        if 'zsh' in shell:
            path = os.path.expanduser("~/.zshrc")
        else:
            path = os.path.expanduser("~/.bashrc")
        with open(path, 'r') as f:
            content = f.read()
        line = f'export PATH="{file_path}:$PATH"'
        if line not in content:
            with open(path, 'a') as f:
                f.write(f'\n{line}\n')
                print(f"{file_path} has been added to PATH environment variable. Please restart your terminal for the changes to take effect.")
    elif system == 'Windows':
        print("I would recommend you to use WSL or Linux system to run this pipeline, but if you want to run it in Windows, please add the BLAST+ bin directory to your PATH environment variable manually.")
    else:
        print("Unsupported system.")
        sys.exit(1)

