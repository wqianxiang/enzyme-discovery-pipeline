            processed_result
        )
        print("step7🚀: Plotting BLAST results...")
        time.sleep(1)
        if filtered_results:
            plot_blast_results(processed_result)
        else:
            print("No filtered BLAST results passed your thresholds. Skip plotting.")
        print("All steps finished! 🎉")
    else:
        print("Sequence blast module do not started.")
        sys.exit(0)
if __name__ == "__main__":
    main()

