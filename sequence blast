import os
import subprocess
import sys
import time
import argparse
import shutil
import glob

def check_wget():
    print("Checking wget...")
    #检查系统中是否已经安装了wget命令
    try:
        if shutil.which("wget") is not None:
            print("wget is already installed.")
            return True
        else:
            print("wget is not installed.")
            #询问用户是否同意安装wget，yes则安装，no则进行下一任务
            while True:
                user_input = input("Do you want to install wget? (yes/no): ").strip().lower()
                if user_input == 'yes':
                    try:
                        subprocess.run(['sudo', 'apt-get', 'update'], check=True)
                        subprocess.run(['sudo', 'apt-get', 'install', '-y', 'wget'], check=True)
                        print("wget installed successfully.")
                        return True
                    except subprocess.CalledProcessError as e:
                        print(f"Error installing wget: {e}")
                        return False
                elif user_input == 'no':
                    print("Skipping wget installation.")
                    return False
                else:
                    print("Invalid input. Please enter 'yes' or 'no'.")
            return False
    except Exception as e:
        print(f"Error checking wget: {e}")
        return False   


def check_blast():
    try:
        if shutil.which("blastp") is not None:
            print("BLAST+ is already installed.")
            return True
        else:
            print("BLAST+ command not found. Please install BLAST+ and ensure it is in your system PATH.")
            #检查是否有解压后的blast文件，如果有则提示用户将其添加到系统PATH中
            blast_path = glob.glob("*ncbi-blast*")
            if blast_path:
                print(f"Found BLAST+ directory: {blast_path[0]}.")
                #将bin文件添加到系统PATH中并永久修改
                bin_path = os.path.join(blast_path[0], "bin")
                if os.path.exists(bin_path):
                    print(f"Adding {bin_path} to system PATH.")
                    os.environ["PATH"] += os.pathsep + bin_path
                    #永久修改系统PATH
                    with open(os.path.expanduser("~/.bashrc"), "a") as f:
                        f.write(f'\nexport PATH="$PATH:{bin_path}"\n')
                    print("BLAST+ added to system PATH. Please restart your terminal or run 'source ~/.bashrc' to apply the changes.")
                    return True
                else:
                    print(f"Error: BLAST+ bin directory not found in {blast_path[0]}. Please check the contents of the directory.")
                    return False
            else:
                print("BLAST+ directory not found. Please download and extract BLAST+ from the NCBI website, and ensure it is in your system PATH.")
                #询问用户是否同意下载BLAST+，yes则下载，no则进行下一任务
                while True:
                    user_input = input("Do you want to download BLAST+? (yes/no): ").strip().lower()
                    if user_input == 'yes':
                        try:
                            blast_url = "https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/LATEST/ncbi-blast-*-x64-linux.tar.gz"
                            subprocess.run(['wget', blast_url, '-O', 'blast.tar.gz'], check=True)
                            subprocess.run(['tar', '-xzf', 'blast.tar.gz'], check=True)
                            os.remove('blast.tar.gz')
                            print("BLAST+ downloaded and extracted successfully. Please ensure the blastp executable is in your system PATH.")
                            #解压tar.gz文件，将解压后的文件夹添加到系统PATH中并永久修改
                            blast_path = glob.glob("*ncbi-blast*")
                            if blast_path:
                                bin_path = os.path.join(blast_path[0], "bin")
                                if os.path.exists(bin_path):
                                    print(f"Adding {bin_path} to system PATH.")
                                    os.environ["PATH"] += os.pathsep + bin_path
                                    #永久修改系统PATH
                                    with open(os.path.expanduser("~/.bashrc"), "a") as f:
                                        f.write(f'\nexport PATH="$PATH:{bin_path}"\n')
                                    print("BLAST+ added to system PATH. Please restart your terminal or run 'source ~/.bashrc' to apply the changes.")
                            return True
                        except subprocess.CalledProcessError as e:
                            print(f"Error downloading or extracting BLAST+: {e}")
                            return False
                    elif user_input == 'no':
                        print("Skipping BLAST+ download.")
                        return False
                    else:
                        print("Invalid input. Please enter 'yes' or 'no'.")
                return False
    except Exception as e:
        print(f"Error checking BLAST+: {e}")
        return False


def check_database(input_name):
    if os.path.exists(input_name):
        print(f"BLAST database '{input_name}' already exists. Skipping download.")
        return input_name

    print("Downloading BLAST database...")

    while True:
        user_input = input(
            "Which BLAST database do you want to download? "
            "1: nr, 2: swissprot, 3: uniprot_trembl, 4: uniprot-Swiss-prot "
        ).strip().lower()

        if user_input == '1' or 'nr' in user_input:
            database_name = "nr"
            url = "https://ftp.ncbi.nlm.nih.gov/blast/db/FASTA/nr.gz"
            break
        elif user_input == '2' or 'swissprot' in user_input:
            database_name = "swissprot"
            url = "https://ftp.ncbi.nlm.nih.gov/blast/db/FASTA/swissprot.gz"
            break
        elif user_input == '3' or 'uniprot_trembl' in user_input:
            database_name = "uniprot_trembl.fasta"
            url = "https://ftp.uniprot.org/pub/databases/uniprot/knowledgebase/complete/uniprot_trembl.fasta.gz"
            break
        elif user_input == '4' or 'uniprot-swiss-prot' in user_input or 'uniprot_sprot' in user_input:
            database_name = "uniprot_sprot.fasta"
            url = "https://ftp.uniprot.org/pub/databases/uniprot/knowledgebase/complete/uniprot_sprot.fasta.gz"
            break
        else:
            print("Invalid input. Please enter 1, 2, 3, or 4. or you can directly input the database name (nr, swissprot, uniprot_trembl, uniprot_swissprot).")

    if os.path.exists(database_name):
        print(f"BLAST database '{database_name}' already exists. Skipping download.")
        return database_name

    try:
        subprocess.run(['wget', '-c', url], check=True)
        subprocess.run(['gunzip', database_name + ".gz"], check=True)
        print("BLAST database downloaded and extracted successfully.")
        return database_name
    except subprocess.CalledProcessError as e:
        print(f"Error downloading or extracting BLAST database: {e}")
        sys.exit(1)


#使用check_databse函数下载的数据库文件创建BLAST数据库
def make_blast_db(db_file):
    try:
        # 检查数据库文件是否已经存在
        if os.path.exists(db_file + ".db.phr"):
            print(f"BLAST database '{db_file}.db' already exists. Skipping database construction.")
            return
        else:
            print(f"Constructing BLAST database from '{db_file}'...")
            subprocess.run(['makeblastdb', '-in', db_file, '-dbtype', 'prot', '-out', db_file + ".db"], check=True)
            print("BLAST database constructed successfully.")
    except subprocess.CalledProcessError as e:
        print(f"Error constructing BLAST database: {e}")
        sys.exit(1)

def run_blast(query, db_file, output, identity_threshold=90, length_threshold=150, max_target_seqs=100000000, evalue=1e-5, outfmt=6):
    blast_cmd = f"blastp -query {query} -max_target_seqs {max_target_seqs} -db {db_file}.db -out {output} -outfmt {outfmt} -num_threads {os.cpu_count()}"
    try:
        subprocess.run(blast_cmd, shell=True, check=True)
        # 添加筛选标准，相似度大于等于90%的结果不保留，序列长度小于150的结果不保留
        if os.path.exists(output):
            with open(output, 'r') as f:
                lines = f.readlines()
            with open(output, 'w') as f:
                for line in lines:
                    columns = line.strip().split('\t')
                    if len(columns) < 12:
                        continue
                    identity = float(columns[2])
                    alignment_length = int(columns[3])
                    if identity <= identity_threshold and alignment_length >= length_threshold:
                        f.write(line)
        print(f"BLAST search completed successfully. Results saved to {output}.")
    except subprocess.CalledProcessError as e:
        print(f"Error running BLAST: {e}")
        sys.exit(1)

def main():

    parser = argparse.ArgumentParser(description="BLAST+ pipeline for protein sequence analysis.")
    parser.add_argument('--query', required=True, help="Path to the query FASTA file.")
    parser.add_argument('--db', required=True, help="Path to the BLAST database file.")
    parser.add_argument('--output', required=True, help="Path to save the BLAST results.")
    parser.add_argument('--max_target_seqs', type=int, default=100000000, help="Maximum number of target sequences to report (default: 100000000).")
    parser.add_argument('--evalue', type=float, default=1e-5, help="E-value threshold for reporting matches (default: 1e-5).")
    parser.add_argument('--outfmt', type=str, default="6", help="Output format for BLAST results (default: 6).")
    parser.add_argument('--identity_threshold', type=int, default=90, help="Minimum identity percentage for reporting matches (default: 90).")
    parser.add_argument('--length_threshold', type=int, default=150, help="Minimum alignment length for reporting matches (default: 150).")
    args = parser.parse_args()

    # 检查wget和BLAST+的安装情况，如果没有安装则提示用户安装
    check_wget()
    check_blast()
    
    # 获取数据库文件路径
    database_file = check_database(args.db)

    # 使用check_database函数下载的数据库文件创建BLAST数据库
    make_blast_db(database_file)

    run_blast(args.query, database_file, args.output, args.identity_threshold, args.length_threshold, args.max_target_seqs, args.outfmt)

if __name__ == "__main__":
    main()



